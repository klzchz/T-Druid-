# Every env var used anywhere in this repo, in one place. Copy this to `.env`
# (already in .gitignore - never commit real values), fill in only the
# sections for the features you're actually using, and `source .env` (or use
# your shell's own dotenv loading) before running the relevant script.

# ── Obsidian MCP connection (docs/SETUP.md, step 4) ────────────────────────
# Not read from env - connect-obsidian.sh/ps1 take the API key as an argument
# instead, since it's a one-time registration, not something a script reads
# repeatedly. See docs/SETUP.md.

# ── Core (bin/) ──────────────────────────────────────────────────────────
TDRUID_VAULT="$HOME/Documents/Obsidian Vault"   # your vault's path

# ── integrations/discord-bot/approval-gate.py ───────────────────────────
DISCORD_BOT_TOKEN=
OWNER_DM_CHANNEL_ID=
TEAMMATE_DM_CHANNEL_ID=

# ── integrations/email-report/send-report.py ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=            # an app password, never your real login password
SMTP_FROM_NAME="Automated report"

# ── skills/byakugan (optional - only if you switch from the Playwright
#    fallback to PRAW for cheaper/more reliable Reddit access) ────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="byakugan/1.0"

# ── integrations/job-scanner ─────────────────────────────────────────────
# No keys needed - RemoteOK/WeWorkRemotely/Greenhouse are public, and the
# browser scanner uses an anonymous profile on purpose (see its README).
